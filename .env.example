# Settings for local runs with `make run` (go run ./cmd/devtool run).
# Copy to .env and adjust. Variables already set in your shell win.
#
# devtool run logs password changes instead of making them unless you pass
# -live. See docs/configuration.md for every variable.

APP_LOG_LEVEL=debug

# presignup hook
APP_PRESIGNUP_ENABLED=true
APP_PRESIGNUP_POLICY_PATH=examples/policies/presignup/domains.rego

# postconfirmation hook; the policy is optional
APP_POSTCONFIRMATION_ENABLED=true
APP_POSTCONFIRMATION_POLICY_PATH=examples/policies/postconfirmation/skip-clients.rego

# email verification for the presignup hook; calls SendGrid when enabled
APP_EMAIL_VERIFICATION_ENABLED=false
APP_EMAIL_VERIFICATION_FOR_TRIGGER_SOURCES=PreSignUp_SignUp
APP_EMAIL_VERIFICATION_ALLOWLIST=
# APP_SENDGRID_API_HOST=https://api.sendgrid.com
# APP_SENDGRID_EMAIL_VERIFICATION_API_KEY=
